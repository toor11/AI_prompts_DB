"domain_logic": {
"implementation_rule": "The following rules must be implemented as pure, independently testable TypeScript functions.",

```
"reservation_overlap": {
  "rule": "A listing must never have two active reservations whose time ranges overlap.",
  "interval_model": "Use half-open intervals: [start, end).",
  "boundary_example": "A reservation ending exactly at 14:00 and another beginning exactly at 14:00 do not overlap.",
  "ignored_statuses": [
    "cancelled",
    "expired"
  ],
  "validation_requirements": [
    "start must be before end",
    "listing identifiers must match before conflicts are evaluated",
    "Only active reservation states block availability"
  ]
},

"pricing": {
  "currency_storage": "All monetary values must be represented as integer cents.",
  "floating_point_rule": "Never use floating-point arithmetic to store or calculate money.",
  "billing_increment_minutes": 15,
  "rounding_rule": "Reservation duration must always round upward to the nearest 15-minute billing increment.",
  "minimum_billable_duration": "60 minutes",
  "long_reservation_discount": {
    "threshold": "24 continuous billable hours",
    "discount_percent": 10,
    "scope": "Apply the discount only to billable time beyond the first 24 hours.",
    "example": "A 30-hour booking receives full price for the first 24 hours and a 10 percent discount only on the remaining 6 hours."
  },
  "pricing_output": [
    "requested_duration_minutes",
    "billable_duration_minutes",
    "rounding_added_minutes",
    "base_price_cents",
    "discount_cents",
    "total_price_cents"
  ]
},

"reservation_holds": {
  "hold_duration_minutes": 10,
  "rule": "A reservation in held state automatically becomes expired if it has not been confirmed within 10 minutes.",
  "availability_rule": "Expired holds immediately stop blocking the corresponding time slot.",
  "ui_requirement": "Held reservations must display a real-time visible countdown.",
  "timer_behavior": [
    "Countdown must update while the UI is open.",
    "Expiry must still be calculated correctly after page reload.",
    "The source of truth must be timestamps rather than an in-memory countdown."
  ]
},

"maintenance": {
  "rule": "Listings with maintenance status cannot accept new reservations.",
  "existing_reservations": "Existing confirmed reservations remain valid and visible."
},

"persistence": {
  "storage": "localStorage",
  "requirements": [
    "Reservations survive a full page reload.",
    "Expired holds are re-evaluated when the application initializes.",
    "Persisted data must be validated or safely migrated if the data structure changes."
  ]
}
